# Cairn hook daemon — permanent owner of the shared hook socket so every
# agent client on the machine (Claude Code, Codex, ...) shares one warm hook
# pipeline. Install:
#   sudo cp deploy/waykeep-daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now waykeep-daemon
# After every `npm run build`, restart to pick up the new dist:
#   sudo systemctl restart waykeep-daemon
#
# Adjust ExecStart's node binary and install paths, plus User/HOME, to match
# your deployment before installing.

[Unit]
Description=Cairn hook daemon (shared agent memory socket)

[Service]
Type=simple
# Placeholders — set these to match your install: the node binary, the Cairn
# install dir, and a dedicated non-root user whose $HOME holds ~/.cairn.
ExecStart=/usr/bin/node /opt/cairn/dist/src/daemon/cairn-daemon.js
WorkingDirectory=/opt/cairn
User=cairn
Environment=HOME=/home/cairn
Restart=always
RestartSec=5
# The daemon exits 1 on a deterministic fatal condition — an insecure state
# dir (fail-closed same-uid refusal) or a config/DB startup error. Restarting
# every 5s can't fix any of those, so stop retrying and let the unit enter
# `failed` (visible in `systemctl status`) instead of spinning in
# `activating (auto-restart)`. Signal deaths (crash/OOM) still restart.
RestartPreventExitStatus=1

[Install]
WantedBy=multi-user.target
